[Unit]
Description=qq-memory 采集器：把 social-v2.json 的滚动窗口增量写进 messages.db
Documentation=file:///root/qq-memory/README.md
After=network.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
# /usr/bin/node 不存在（远端用 nvm 装的），必须写绝对路径
ExecStart=/usr/bin/flock -n /root/qq-memory/data/.collect.lock /root/.nvm/versions/node/v24.21.0/bin/node /root/qq-memory/bin/qqmem.mjs collect
# 采集是幂等的：同一批消息重复写会被 dedupe 索引吃掉，跳过不算失败
TimeoutStartSec=120
